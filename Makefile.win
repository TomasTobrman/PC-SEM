# ==== Project Info ========================================================== #

PROJECT := othello
EXTENSION := .exe

# ==== Directories =========================================================== #

DIR_OBJ := obj
DIR_SRC := src
DIR_INC := include

# ==== Files ================================================================= #

TARGET := $(PROJECT)$(EXTENSION)
SOURCES := \
	$(DIR_SRC)\\board.c \
	$(DIR_SRC)\\file.c \
	$(DIR_SRC)\\history.c \
	$(DIR_SRC)\\main.c \
	$(DIR_SRC)\\minimax.c \
	$(DIR_SRC)\\othello.c \
	$(DIR_SRC)\\settings.c
OBJECTS := $(patsubst $(DIR_SRC)\\%.c, $(DIR_OBJ)\\%.o, $(SOURCES))

# ==== Commands ============================================================== #

WARN := -Wall

CC := gcc.exe
CFLAGS := -xc -std=c90 -I$(DIR_INC) -g

LD := gcc.exe
LDFLAGS := 

# ==== PHONY ================================================================= #

default: mkdirs build

.PHONY: build
build: $(TARGET)

.PHONY: clean
clean:
	del $(TARGET) $(DIR_OBJ)\\*.o

.PHONY: mkdirs
mkdirs: $(DIR_OBJ)

# ==== Targets =============================================================== #

$(DIR_OBJ):
	mkdir $@

$(TARGET): $(OBJECTS)
	$(LD) $(WARN) $(LDFLAGS) -o $@ $^

$(DIR_OBJ)/%.o: $(DIR_SRC)/%.c
	$(CC) $(WARN) $(CFLAGS) -c -o $@ $^

# ============================================================================ #
